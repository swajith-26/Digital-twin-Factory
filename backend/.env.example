# Copy this file to ".env" (same folder) and fill in your values.
# .env is read automatically by api.py and mqtt_subscriber.py. Never commit it.

# --- PostgreSQL ---------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_twin_factory
DB_USER=postgres
DB_PASSWORD=change-me

# --- MQTT (must match wokwi/sketch.ino and simulator/simulator.py) -------
MQTT_BROKER=test.mosquitto.org
MQTT_PORT=1883
# Topics are <prefix>/machine01 ... and <prefix>/machine01/status
MQTT_TOPIC_PREFIX=digitaltwin/factory
# MQTT_USERNAME=backend
# MQTT_PASSWORD=change-me

# --- Platform -----------------------------------------------------------
# Seconds without a new reading before a machine is reported "Offline".
STALE_AFTER_SECONDS=15
# Raw readings older than this are purged (0 = keep forever).
RETENTION_DAYS=30
# If set, write actions (acknowledge, work orders, thresholds) need the header
# X-API-Key: <value>. The dashboard sends frontend/.env VITE_API_KEY.
# API_KEY=change-me
# Extra browser origins allowed by CORS (localhost/127.0.0.1 always allowed).
# CORS_ORIGINS=https://my-dashboard.example.com
